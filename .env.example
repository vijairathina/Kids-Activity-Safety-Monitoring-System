# Kids Activity & Safety Monitoring System Environment Variables
PORT=5000
HOST=0.0.0.0

# Camera Authentication (Optional overrides)
RTSP_URL=rtsp://admin:cameraPassword@192.168.1.100:554/live/ch0
RTSP_SUB_URL=rtsp://admin:cameraPassword@192.168.1.100:554/live/ch1

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MQTT Broker (Home Assistant)
MQTT_BROKER=192.168.1.50
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Home Assistant Webhook URL
HA_WEBHOOK_URL=
